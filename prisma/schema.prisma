generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CloudMode {
  private_cloud
  public_cloud
  hybrid_cloud
}

enum CloudLocation {
  private_cloud
  public_cloud
  saas
  backup
  deception
}

enum DataClassification {
  public
  internal
  confidential
  sensitive
  critical
}

enum DataTemperature {
  hot
  warm
  cold
}

enum StorageType {
  database
  object_storage
  file_share
  saas_export
  backup_archive
  deception_storage
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum DeviceTrust {
  trusted
  managed
  unknown
  compromised
}

enum AccessAction {
  read
  write
  export
  delete
  admin
}

enum IdentityType {
  user
  service
  third_party
}

enum IdentityStatus {
  active
  watchlist
  suspicious
  isolated
}

enum ZeroTrustDecision {
  allow
  limited_allow
  require_step_up_auth
  deny
  isolate
}

enum RequestStatus {
  pending
  approved
  rejected
  step_up
  isolated
}

enum EventSeverity {
  info
  low
  medium
  high
  critical
}

enum EventStatus {
  open
  investigating
  contained
  resolved
  false_positive
}

enum EventCategory {
  auth_failure
  mfa_failure
  login_success
  admin_access_denied
  admin_access_granted
  settings_changed
  role_changed
  status_changed
  trap_triggered
  data_asset_risk
  access_request_created
  zero_trust_decision
  compliance_gap
  system_health_degraded
  report_generated
  unauthorized_access_attempt
  suspicious_export
  public_bucket_detected
  missing_encryption
  impossible_travel
  api_abuse
  deception_triggered
  ransomware_indicator
  privilege_escalation
  policy_violation
  third_party_anomaly
  visibility_gap
}

enum SoarAction {
  account_lock
  revoke_token
  require_mfa
  isolate_identity
  isolate_resource
  create_ticket
  notify_security_team
  mark_contained
  mark_resolved
}

enum DeceptionAssetType {
  bucket
  database
  api
  token_store
  log_archive
}

enum ReportType {
  general
  critical_data
  zero_trust
  deception
  nist
  privacy
  demo
}

enum UserRole {
  security_admin
  cloud_security_analyst
  compliance_officer
  auditor
  executive
}

enum UserStatus {
  active
  invited
  suspended
}

enum OrganizationInviteStatus {
  pending
  accepted
  revoked
  expired
}

enum PlatformRole {
  USER
  ADMIN
}

enum AuditSeverity {
  info
  warning
  high
  critical
}

enum AuditResult {
  success
  failure
  blocked
}

enum NotificationType {
  critical_event
  deception_alarm
  report_ready
  compliance_changed
  playbook_completed
  access_request_pending
  simulation_completed
}

enum SessionStatus {
  pending_2fa
  active
  revoked
  expired
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  plan                 String
  region               String
  cloudMode            CloudMode
  complianceFrameworks Json
  demoMode             Boolean   @default(false)
  onboardingCompleted  Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships         Membership[]
  invites             OrganizationInvite[]
  sessions            Session[]
  assets              Asset[]
  identityProfiles    IdentityProfile[]
  accessRequests      AccessRequest[]
  events              SecurityEvent[]
  deceptionAssets     DeceptionAsset[]
  deceptionTriggers   DeceptionTrigger[]
  playbookExecutions  PlaybookExecution[]
  reports             Report[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  complianceSnapshots ComplianceSnapshot[]
  simulationRuns      SimulationRun[]
  settings            OrganizationSettings?
  riskPolicy          RiskPolicy?
  reportBranding      ReportBranding?
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  passwordHash   String
  role           UserRole
  platformRole   PlatformRole @default(USER)
  department     String?
  avatarInitials String?
  status         UserStatus @default(active)
  mfaEnabled     Boolean    @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  memberships     Membership[]
  sentInvites     OrganizationInvite[] @relation("InviteSender")
  sessions        Session[]
  twoFactorSecret TwoFactorSecret?
  recoveryCodes   RecoveryCode[]
  passwordResetTokens PasswordResetToken[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  updatedAppSettings AppSetting[]
}

model Membership {
  id                  String   @id @default(cuid())
  userId              String
  organizationId      String
  role                UserRole
  permissionOverrides Json?
  createdAt           DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Session {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  tokenHash      String        @unique
  status         SessionStatus @default(pending_2fa)
  is2FAVerified  Boolean       @default(false)
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  lastSeenAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, status])
}

model TwoFactorSecret {
  id        String    @id @default(cuid())
  userId    String    @unique
  secret    String
  issuer    String
  label     String
  enabledAt DateTime?
  enrolledAt DateTime?
  lastVerifiedAt DateTime?
  lastVerifiedStep Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model OrganizationInvite {
  id              String                   @id @default(cuid())
  organizationId  String
  email           String
  role            UserRole
  tokenHash       String                   @unique
  status          OrganizationInviteStatus @default(pending)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InviteSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, email])
  @@index([expiresAt])
}

model Asset {
  id                  String             @id @default(cuid())
  organizationId      String
  ownerUserId         String?
  name                String
  path                String
  inventoryType       String?
  dataType            String
  description         String?
  exposure            String             @default("internal")
  environment         String             @default("hybrid")
  provider            String?
  location            CloudLocation
  storageType         StorageType
  classification      DataClassification
  temperature         DataTemperature
  owner               String
  encryptionEnabled   Boolean
  kmsEnabled          Boolean
  backupEnabled       Boolean
  kvkkScope           Boolean
  gdprScope           Boolean
  privacyTags         Json
  retentionPolicy     String
  anonymizationStatus String
  lastAccessedAt      DateTime?
  accessCount24h      Int                @default(0)
  accessIntensity     Int                @default(0)
  riskScore           Int                @default(0)
  riskLevel           RiskLevel          @default(low)
  riskReasons         Json
  recommendedControls Json
  findings            Json
  tags                Json?
  inventoryStatus     String             @default("ACTIVE")
  isDeception         Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accessRequests AccessRequest[]
  eventLinks     SecurityEvent[]   @relation("EventRelatedAsset")
  reportLinks    ReportAssetLink[]

  @@unique([organizationId, path])
  @@index([organizationId, classification])
  @@index([organizationId, riskLevel])
}

model IdentityProfile {
  id              String         @id @default(cuid())
  organizationId  String
  name            String
  type            IdentityType
  role            String
  department      String?
  homeLocation    CloudLocation
  region          String
  mfaEnabled      Boolean        @default(false)
  deviceTrust     DeviceTrust
  anomalyScore    Int            @default(0)
  riskScore       Int            @default(0)
  status          IdentityStatus @default(active)
  lastSeenAt      DateTime?
  notes           Json
  accessVolume24h Int            @default(0)
  tags            Json
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accessRequests    AccessRequest[]
  deceptionTriggers DeceptionTrigger[]
  relatedEvents     SecurityEvent[]    @relation("EventRelatedIdentity")

  @@index([organizationId, status])
  @@index([organizationId, type])
}

model AccessRequest {
  id                String             @id @default(cuid())
  organizationId    String
  identityProfileId String
  assetId           String
  requestedAction   AccessAction
  justification     String?
  sourceLocation    CloudLocation
  sourceRegion      String
  deviceTrust       DeviceTrust
  mfa               Boolean            @default(false)
  anomalyScore      Int                @default(0)
  locationRisk      RiskLevel
  timeRisk          String
  decision          ZeroTrustDecision?
  riskScore         Int?
  status            RequestStatus      @default(pending)
  decisionReasons   Json
  requiredActions   Json
  policyMatches     Json
  requestedAt       DateTime           @default(now())
  decidedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identityProfile IdentityProfile @relation(fields: [identityProfileId], references: [id], onDelete: Cascade)
  asset           Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  relatedEvents   SecurityEvent[] @relation("EventRelatedAccessRequest")

  @@index([organizationId, status, requestedAt])
  @@index([organizationId, identityProfileId])
  @@index([organizationId, assetId])
}

model SecurityEvent {
  id                      String        @id @default(cuid())
  organizationId          String
  actorUserId             String?
  actorEmail              String?
  title                   String
  severity                EventSeverity
  category                EventCategory
  eventType               String?       @map("type")
  source                  String
  target                  String
  targetType              String?
  targetId                String?
  description             String
  riskScore               Int           @default(0)
  ipAddress               String?
  userAgent               String?
  relatedControl          String?
  recommendation          String?
  status                  EventStatus   @default(open)
  evidence                Json
  metadata                Json?
  playbookActions         Json
  relatedAssetId          String?
  relatedIdentityId       String?
  relatedAccessRequestId  String?
  relatedDeceptionAssetId String?
  resolvedAt              DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relatedAsset          Asset?               @relation("EventRelatedAsset", fields: [relatedAssetId], references: [id], onDelete: SetNull)
  relatedIdentity       IdentityProfile?     @relation("EventRelatedIdentity", fields: [relatedIdentityId], references: [id], onDelete: SetNull)
  relatedAccessRequest  AccessRequest?       @relation("EventRelatedAccessRequest", fields: [relatedAccessRequestId], references: [id], onDelete: SetNull)
  relatedDeceptionAsset DeceptionAsset?      @relation(fields: [relatedDeceptionAssetId], references: [id], onDelete: SetNull)
  timelineEntries       EventTimelineEntry[]
  playbookExecutions    PlaybookExecution[]
  reportLinks           ReportEventLink[]
  deceptionTriggers     DeceptionTrigger[]

  @@index([organizationId, severity, status, createdAt])
  @@index([organizationId, category])
}

model EventTimelineEntry {
  id        String   @id @default(cuid())
  eventId   String
  actor     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event SecurityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

model DeceptionAsset {
  id                  String             @id @default(cuid())
  organizationId      String
  name                String
  location            CloudLocation
  description         String
  containsRealData    Boolean            @default(false)
  fakeType            DeceptionAssetType
  lureScore           Int
  triggerCount        Int                @default(0)
  lastTriggeredAt     DateTime?
  mappedThreat        String
  severity            EventSeverity
  recommendedResponse String
  autoActions         Json
  status              String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relatedEvents SecurityEvent[]
  triggers      DeceptionTrigger[]

  @@unique([organizationId, name])
  @@index([organizationId, fakeType])
}

model DeceptionTrigger {
  id                String   @id @default(cuid())
  organizationId    String
  deceptionAssetId  String
  identityProfileId String?
  eventId           String?
  sourceIp          String?
  userAgent         String?
  requestHeaders    Json?
  requestPath       String?
  createdAt         DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deceptionAsset  DeceptionAsset   @relation(fields: [deceptionAssetId], references: [id], onDelete: Cascade)
  identityProfile IdentityProfile? @relation(fields: [identityProfileId], references: [id], onDelete: SetNull)
  event           SecurityEvent?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model PlaybookExecution {
  id             String     @id @default(cuid())
  organizationId String
  eventId        String
  action         SoarAction
  status         String
  summary        String
  executedBy     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        SecurityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model ComplianceSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  overallScore   Int
  iso27001Score  Int
  kvkkScore      Int
  gdprScore      Int
  indicators     Json
  matrix         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  functions    ComplianceFunctionScore[]

  @@index([organizationId, createdAt])
}

model ComplianceFunctionScore {
  id                   String @id @default(cuid())
  complianceSnapshotId String
  name                 String
  score                Int
  status               String
  controls             Json
  gaps                 Json
  improvements         Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  snapshot ComplianceSnapshot @relation(fields: [complianceSnapshotId], references: [id], onDelete: Cascade)
}

model Report {
  id                 String     @id @default(cuid())
  organizationId     String
  title              String
  type               ReportType
  status             String     @default("generated")
  summary            String
  findings           Json
  risks              Json
  recommendedActions Json
  relatedControls    Json
  markdownContent    String?
  snapshotJson       Json
  generatedBy        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventLinks   ReportEventLink[]
  assetLinks   ReportAssetLink[]

  @@index([organizationId, type, createdAt])
}

model ReportEventLink {
  id       String @id @default(cuid())
  reportId String
  eventId  String

  report Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  event  SecurityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([reportId, eventId])
}

model ReportAssetLink {
  id       String @id @default(cuid())
  reportId String
  assetId  String

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([reportId, assetId])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String
  userId         String?
  actorName      String
  actorRole      String
  action         String
  module         String
  target         String
  severity       AuditSeverity
  result         AuditResult
  ipAddress      String?
  device         String?
  details        String
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  title          String
  description    String
  type           NotificationType
  severity       EventSeverity
  module         String
  actionHref     String?
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, readAt, createdAt])
}

model OrganizationSettings {
  id                   String    @id @default(cuid())
  organizationId       String    @unique
  region               String
  cloudMode            CloudMode
  complianceFrameworks Json
  usageType            String?
  defaultCurrency      String?
  setupCompletedAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model RiskPolicy {
  id                           String   @id @default(cuid())
  organizationId               String   @unique
  criticalClassificationWeight Int
  missingEncryptionWeight      Int
  publicCloudSensitiveWeight   Int
  missingBackupWeight          Int
  noKmsWeight                  Int
  openCriticalEventWeight      Int
  deceptionTriggerWeight       Int
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ReportBranding {
  id                   String   @id @default(cuid())
  organizationId       String   @unique
  companyName          String
  reportFooter         String
  preparedByLabel      String
  confidentialityLabel String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SimulationRun {
  id                 String   @id @default(cuid())
  organizationId     String
  scenarioId         String
  summary            String
  generatedEventIds  Json
  generatedReportIds Json
  affectedModules    Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}
